# GoWager Backend Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL connection string from Neon.tech
# Example: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/gowager?sslmode=require
# REQUIRED in production — without it the server falls back to an in-memory
# store that WIPES wallet balances on every restart. Do not accept real money
# deposits without setting this.
DATABASE_URL=

# When '1', the server refuses to start unless it is connected to Postgres.
# Prevents a silent, accidental reset of user balances. Set to 1 on Render.
ENFORCE_DATABASE=1

# Passcode for the /api/admin/* withdrawal-request endpoints (webapp Admin tab).
# Change this to something secret on Render.
ADMIN_PASSCODE=gowager-admin

# Port for the backend server (default: 3001)
PORT=3001

# Paystack payment keys
# Test mode keys (from paystack.txt). Swap to live keys when ready for real money.
PAYSTACK_SECRET_KEY=sk_test_9b23cdc9a3e4f434b0c1c77ac497273f38793e05
PAYSTACK_PUBLIC_KEY=pk_test_b8b463874f7ea223e1a016c9383d4b5b9672d2c0

# Currency for Paystack payments ('NGN' = Nigeria/naira, 'GHS' = Ghana/cedis)
PAYSTACK_CURRENCY=NGN