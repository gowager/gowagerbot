# GoWager Backend Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL connection string from Neon.tech
# Example: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/gowager?sslmode=require
DATABASE_URL=

# Port for the backend server (default: 3001)
PORT=3001

# Paystack payment keys
# Test mode keys (from paystack.txt). Swap to live keys when ready for real money.
PAYSTACK_SECRET_KEY=sk_test_9b23cdc9a3e4f434b0c1c77ac497273f38793e05
PAYSTACK_PUBLIC_KEY=pk_test_b8b463874f7ea223e1a016c9383d4b5b9672d2c0

# Currency for Paystack payments ('NGN' = Nigeria/naira, 'GHS' = Ghana/cedis)
PAYSTACK_CURRENCY=NGN